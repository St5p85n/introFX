<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.intrfx.HelloController">
   <children>
      <Pane prefHeight="400.0" prefWidth="239.0" style="-fx-background-color: black;">
         <children>
            <Label layoutX="90.0" layoutY="8.0" text="GESTION" textFill="#fcfcfc">
               <font>
                  <Font name="System Bold" size="35.0" />
               </font>
            </Label>
            <Label layoutX="30.0" layoutY="78.0" text="Nom" textFill="#fcfcfc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="nom" layoutX="30.0" layoutY="104.0" />
            <Button layoutX="30.0" layoutY="358.0" mnemonicParsing="false" onAction="#ajouter" style="-fx-background-color: green;" text="Ajouter" textFill="WHITE" />
            <Label layoutX="30.0" layoutY="138.0" text="Prenom" textFill="#fcfcfc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="prenom" layoutX="30.0" layoutY="164.0" />
            <Label layoutX="30.0" layoutY="198.0" text="Email" textFill="#fcfcfc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="email" layoutX="30.0" layoutY="224.0" />
            <Label layoutX="30.0" layoutY="258.0" text="Role" textFill="#fcfcfc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="role" layoutX="30.0" layoutY="284.0" />
         </children>
      </Pane>
      <Pane layoutX="238.0" prefHeight="400.0" prefWidth="455.0" style="-fx-background-color: green;">
         <children>
            <TableView fx:id="tableUtilisateur" layoutX="3.0" layoutY="74.0" prefHeight="200.0" prefWidth="445.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="38.0" text="id" />
                <TableColumn fx:id="colUsername" prefWidth="72.0" text="username" />
                  <TableColumn fx:id="colRole" prefWidth="68.0" text="role" />
                  <TableColumn fx:id="colEmail" prefWidth="86.0" text="email" />
                  <TableColumn fx:id="colName" prefWidth="111.0" text="name" />
                  <TableColumn fx:id="colPassword" prefWidth="111.0" text="password" />
              </columns>
            </TableView>
            <Label layoutX="1.0" layoutY="13.0" text="UTILISATEUR">
               <font>
                  <Font size="35.0" />
               </font>
            </Label>
         </children></Pane>
   </children>
</AnchorPane>
